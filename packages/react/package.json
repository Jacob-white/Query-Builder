{
  "name": "@jacob-white/query-builder-react",
  "version": "1.0.0",
  "description": "Portable, embeddable React Visual SQL Query Builder & Schema Explorer component library.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters.mjs",
      "require": "./dist/adapters.cjs",
      "default": "./dist/adapters.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks.mjs",
      "require": "./dist/hooks.cjs",
      "default": "./dist/hooks.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs",
      "default": "./dist/client.mjs"
    },
    "./olap": {
      "types": "./dist/olap/index.d.ts",
      "import": "./dist/olap.mjs",
      "require": "./dist/olap.cjs",
      "default": "./dist/olap.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 35",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "react",
    "sql",
    "query-builder",
    "visual-sql",
    "erd",
    "database"
  ],
  "author": "HobbyHabbit LLC <support@hobbyhabbit.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
